{
  "id": "/",
  "name": "Quick Web Notepad",
  "short_name": "Notepad",
  "description": "Quick Web Notepad is a free, open-source notepad that runs entirely in your browser: no account, notes are not uploaded, and it works offline.",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14151b",
  "theme_color": "#14151b",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/og-image.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Quick Web Notepad showing a Markdown note"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "780x1560",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "A Markdown note on a phone"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [
          ".txt",
          ".log"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Markdown viewer",
      "short_name": "Markdown",
      "description": "Open a Markdown file and read it formatted",
      "url": "/markdown-viewer/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
